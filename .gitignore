# ignore everything in the root except the "wp-content" directory.
!wp-content/

# ignore everything in the "wp-content" directory, except:
# "mu-plugins", "plugins", "themes" directory
wp-content/*
!wp-content/mu-plugins/
!wp-content/plugins/
!wp-content/themes/

# ignore these plugins
wp-content/plugins/hello.php

# ignore specific themes
wp-content/themes/twenty*/

# ignore node dependency directories
node_modules/

# ignore log files and databases
*.log
*.sql
*.sqlite

# Email vs ClickUp cross-check: never commit configuration, credentials or reports
email-clickup-crosscheck/config.yaml
email-clickup-crosscheck/output/
email-clickup-crosscheck/*.html
email-clickup-crosscheck/client_secret*.json
email-clickup-crosscheck/.env
__pycache__/
.pytest_cache/
